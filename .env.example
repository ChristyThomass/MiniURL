# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
# Path to SQLite database file. Automatically created if it does not exist.
DB_PATH=./data/shortener.sqlite

# Rate Limiting Configuration
# Maximum requests allowed per IP within the window for /api/shorten
RATE_LIMIT_MAX=100
# Window duration in milliseconds (e.g. 15 minutes = 900000)
RATE_LIMIT_WINDOW_MS=900000

# Base Application URL (Optional override)
APP_URL=http://localhost:3000

# Gemini API Key (Optional, provided by AI Studio environment)
GEMINI_API_KEY=
